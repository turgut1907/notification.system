# Copy to .env and adjust. All values have sensible defaults for docker-compose.

# Required for the API: HMAC secret for JWT validation (min 32 characters).
JWT_SECRET=

# Logging: debug | info | warn | error
LOG_LEVEL=info

# External provider endpoint. Create a free URL at https://webhook.site and paste
# it here so you can watch deliveries arrive. Leave empty to no-op (sends fail).
PROVIDER_WEBHOOK_URL=

# Rate limiting: "redis" (fleet-wide) or "inproc" (single-replica fallback).
RATE_LIMITER=redis
RATE_LIMIT_PER_SECOND=100

# Which priority streams the worker consumes (comma-separated, high to low).
WORKER_PRIORITIES=high,normal,low
